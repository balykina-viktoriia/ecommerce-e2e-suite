# Local test credentials for the shop app. Copy to .env to override the defaults
# in docker-compose.yml. These accounts exist only inside the local containers.
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop
DB_PORT=5433
APP_PORT=8000

JWT_SECRET=local-dev-secret-change-me-0123456789
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-pass
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer-pass
